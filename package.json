    "@scure/base": "^1.2.6",
    "dexie": "^4.4.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
